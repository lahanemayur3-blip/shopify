@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Shopify Order - Interface View'
define root view entity ZI_SHOPIFY_ORDER
  as select from zshopify_order
{
  key uuid as Uuid,
  id as ShopifyOrderId,
  created_at as CreatedAt,
  cancel_reason as CancelReason,
  cancelled_at as CancelledAt,
  updated_date as UpdatedDate,
  updated_time as UpdatedTime,
  confirmation_number as ConfirmationNumber,
  current_subtotal_price as CurrentSubtotalPrice,
  current_total_discounts as CurrentTotalDiscounts,
  current_total_tax as CurrentTotalTax,
  order_number as OrderNumber,
  tags as Tags,
  tax_line_title as TaxLineTitle,
  total_line_items_price as TotalLineItemsPrice,
  total_shipping_amount as TotalShippingAmount,
  billing_address1 as BillingAddress1,
  billing_phone as BillingPhone,
  billing_city as BillingCity,
  billing_zip as BillingZip,
  billing_name as BillingName,
  billing_country_code as BillingCountryCode,
  billing_province_code as BillingProvinceCode,
  customer_email as CustomerEmail,
  customer_phone as CustomerPhone,
  cust_def_address1 as CustDefAddress1,
  cust_def_city as CustDefCity,
  cust_def_zip as CustDefZip,
  cust_def_phone as CustDefPhone,
  cust_def_name as CustDefName,
  cust_def_province_code as CustDefProvinceCode,
  cust_def_country_code as CustDefCountryCode,
  line_item_id as LineItemId,
  line_item_quantity as LineItemQuantity,
  line_item_fulfillable_qty as LineItemFulfillableQty,
  product_id as ProductId,
  sku as Sku,
  shipping_address1 as ShippingAddress1,
  shipping_phone as ShippingPhone,
  shipping_city as ShippingCity,
  shipping_zip as ShippingZip,
  shipping_name as ShippingName,
  shipping_country_code as ShippingCountryCode,
  shipping_province_code as ShippingProvinceCode
}
